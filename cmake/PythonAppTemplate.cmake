include_guard(GLOBAL)

# Integrates a uv-managed Python project into the build:
# - build time: `uv sync` (venv in build/venvs/<TARGET>)
# - run time: launcher at `build/bin/<Config>/<TARGET>` running
#   `uv run --project <project> --no-sync <SCRIPT>`
#
# Keeps `just build`, `just run` and `ctest` working for Python apps.
# Tests are registered separately with add_python_tests() from test/.
function(create_python_app TARGET)
    cmake_parse_arguments(
        PYAPP
        ""
        "PROJECT_DIR;SCRIPT"
        "SYNC_ARGS;RUN_ARGS"
        ${ARGN}
    )

    if(NOT PYAPP_PROJECT_DIR)
        set(PYAPP_PROJECT_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    endif()

    if(NOT PYAPP_SCRIPT)
        set(PYAPP_SCRIPT "${TARGET}")
    endif()

    # All Python-generated state (venv, pycache, tool caches) lives in the
    # build tree; keep these in sync with justfile exports.
    set(_venv "${CMAKE_BINARY_DIR}/venvs/${TARGET}/.venv")
    set(_pycache "${CMAKE_BINARY_DIR}/pycache")
    set(_ruff_cache "${CMAKE_BINARY_DIR}/ruff-cache")

    # Sync the venv at build time.
    add_custom_target(
        ${TARGET}
        ALL
        COMMAND
            "${CMAKE_COMMAND}" -E env "UV_PROJECT_ENVIRONMENT=${_venv}"
            "${UV}" sync ${PYAPP_SYNC_ARGS}
        WORKING_DIRECTORY "${PYAPP_PROJECT_DIR}"
        COMMENT "uv sync (${TARGET})"
        VERBATIM
    )

    # Launcher mimicking a C++ executable. file(GENERATE) expands $<CONFIG>
    # for multi-config generators (one launcher per configuration).
    set(_launcher
        "\
#!/bin/sh
# Generated by cmake/PythonAppTemplate.cmake - do not edit.
export UV_PROJECT_ENVIRONMENT=\"${_venv}\"
export PYTHONPYCACHEPREFIX=\"${_pycache}\"
export RUFF_CACHE_DIR=\"${_ruff_cache}\"
exec \"${UV}\" run --project \"${PYAPP_PROJECT_DIR}\" \
    --no-sync ${PYAPP_RUN_ARGS} ${PYAPP_SCRIPT} \"$@\"
"
    )
    file(
        GENERATE OUTPUT "${CMAKE_BINARY_DIR}/bin/$<CONFIG>/${TARGET}"
        CONTENT "${_launcher}"
        FILE_PERMISSIONS
            OWNER_READ
            OWNER_WRITE
            OWNER_EXECUTE
            GROUP_READ
            GROUP_EXECUTE
            WORLD_READ
            WORLD_EXECUTE
    )

    install(
        FILES "${CMAKE_BINARY_DIR}/bin/$<CONFIG>/${TARGET}"
        DESTINATION bin
        PERMISSIONS
            OWNER_READ
            OWNER_WRITE
            OWNER_EXECUTE
            GROUP_READ
            GROUP_EXECUTE
            WORLD_READ
            WORLD_EXECUTE
    )
    install(
        DIRECTORY "${PYAPP_PROJECT_DIR}/"
        DESTINATION "python/${TARGET}"
        PATTERN ".venv" EXCLUDE
        PATTERN "__pycache__" EXCLUDE
        PATTERN "*.pyc" EXCLUDE
    )
endfunction()

# Registers `<TARGET>.import` (module importable) and `<TARGET>.pytest`
function(add_python_tests TARGET)
    cmake_parse_arguments(
        PYTEST
        ""
        "PROJECT_DIR;TEST_DIR;MODULE"
        "PYTEST_ARGS"
        ${ARGN}
    )

    if(NOT PYTEST_PROJECT_DIR OR NOT PYTEST_TEST_DIR)
        message(
            FATAL_ERROR
            "add_python_tests(${TARGET}) needs PROJECT_DIR and TEST_DIR"
        )
    endif()

    string(REPLACE "-" "_" _default_module "${TARGET}")
    if(NOT PYTEST_MODULE)
        set(PYTEST_MODULE "${_default_module}")
    endif()
    if(NOT PYTEST_PYTEST_ARGS)
        set(PYTEST_PYTEST_ARGS "--group" "dev")
    endif()

    set(_env "\
UV_PROJECT_ENVIRONMENT=${CMAKE_BINARY_DIR}/venvs/${TARGET}/.venv;\
PYTHONPYCACHEPREFIX=${CMAKE_BINARY_DIR}/pycache"
    )

    add_test(
        NAME "${TARGET}.import"
        COMMAND
            "${UV}" run --project "${PYTEST_PROJECT_DIR}" --no-sync
            python -c "import ${PYTEST_MODULE}"
        WORKING_DIRECTORY "${PYTEST_PROJECT_DIR}"
    )
    add_test(
        NAME "${TARGET}.pytest"
        COMMAND
            "${UV}" run --project "${PYTEST_PROJECT_DIR}" --no-sync
            ${PYTEST_PYTEST_ARGS} pytest -o
            "cache_dir=${CMAKE_BINARY_DIR}/pytest-cache" "${PYTEST_TEST_DIR}"
        WORKING_DIRECTORY "${PYTEST_PROJECT_DIR}"
    )
    set_tests_properties(
        "${TARGET}.import"
        "${TARGET}.pytest"
        PROPERTIES LABELS "python" ENVIRONMENT "${_env}"
    )
endfunction()
