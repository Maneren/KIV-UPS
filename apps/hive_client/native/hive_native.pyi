from hive_client.domain.game import GameResult
from hive_client.domain.geometry import TilePointer
from hive_client.domain.moves import Move
from hive_client.domain.pieces import Piece, PieceKind, Player

class HiveError(RuntimeError): ...
class IllegalMoveError(HiveError): ...
class EmptyTileError(HiveError): ...

class Game:
    def __init__(self) -> None: ...
    @property
    def current_player(self) -> Player: ...
    @property
    def result(self) -> GameResult: ...
    def is_empty_all(self) -> bool: ...
    def stacks(self) -> list[tuple[TilePointer, list[Piece]]]: ...
    def occupied_tiles(self) -> set[TilePointer]: ...
    def tiles_around_hive(self) -> set[TilePointer]: ...
    def top(self, tile: TilePointer, /) -> Piece: ...
    def is_empty(self, tile: TilePointer, /) -> bool: ...
    def remaining(self, player: Player, /) -> dict[PieceKind, int]: ...
    def has_placed_queen(self, player: Player, /) -> bool: ...
    def can_place(self, kind: PieceKind, /) -> bool: ...
    def can_move_from(self, tile: TilePointer, /) -> bool: ...
    def placement_targets(self) -> list[TilePointer]: ...
    def moves_from(self, tile: TilePointer, /) -> list[Move]: ...
    def submit(self, move: Move, /) -> bool: ...
    def apply(self, move: Move, /) -> None: ...
    def pass_if_stuck(self) -> bool: ...
