type MoveRecord = tuple[int, int, int, int, int, int]
type TileRecord = tuple[int, int]
type PieceRecord = tuple[int, int]

class HiveError(RuntimeError): ...
class IllegalMoveError(HiveError): ...
class EmptyTileError(HiveError): ...

class Game:
    def __init__(self) -> None: ...
    @property
    def current_player(self) -> int: ...
    @property
    def result(self) -> int: ...
    def is_empty_all(self) -> bool: ...
    def stacks(self) -> list[tuple[int, int, list[PieceRecord]]]: ...
    def occupied_tiles(self) -> list[TileRecord]: ...
    def tiles_around_hive(self) -> list[TileRecord]: ...
    def top(self, p: int, q: int, /) -> tuple[int, int] | None: ...
    def is_empty(self, p: int, q: int, /) -> bool: ...
    def remaining(self, player: int, /) -> list[int]: ...
    def has_placed_queen(self, player: int, /) -> bool: ...
    def can_place(self, kind: int, /) -> bool: ...
    def can_move_from(self, p: int, q: int, /) -> bool: ...
    def placement_targets(self) -> list[TileRecord]: ...
    def moves_from(self, p: int, q: int, /) -> list[MoveRecord]: ...
    def submit(self, move: MoveRecord, /) -> bool: ...
    def apply(self, move: MoveRecord, /) -> None: ...
    def pass_if_stuck(self) -> bool: ...
